#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=${MLPL:-"$repo_root/../sw-mlpl/target/release/mlpl-repl"}
scratch=$(mktemp -d "${TMPDIR:-/tmp}/demo-combinators-gates.XXXXXX")
trap 'rm -rf "$scratch"' EXIT HUP INT TERM

if [ ! -x "$mlpl" ]; then
  echo "mlpl-repl is not executable: $mlpl" >&2
  exit 1
fi

check_gate() {
  fixture=$1
  expected=$2
  output="$scratch/output.txt"

  if "$mlpl" --source-dir "$repo_root" "$repo_root/$fixture" >"$output" 2>&1; then
    echo "UNBLOCKED $fixture"
    echo "move this fixture into the discovered suite" >&2
    return 1
  fi
  if ! rg -F "$expected" "$output" >/dev/null; then
    echo "CHANGED $fixture" >&2
    sed -n '1,20p' "$output" >&2
    return 1
  fi
  echo "GATED $fixture :: $expected"
}

check_gate acceptance/progressive_application.mlpl "u:kestrel expects 2 arguments, got 1"
check_gate acceptance/sk_basis.mlpl "u:starling expects 3 arguments, got 1"

