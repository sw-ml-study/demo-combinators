# Bird-named combinators in the applicative style supported by sw-MLPL today.
#
# Each definition is named and contains no free variables. Function values are
# explicit :u: references; call invokes them. Until progressive application is
# implemented, callers must supply each bird's complete argument list.

def u:idiot(x) { "I x = x (Identity)."; x }

def u:kestrel(x, y) { "K x y = x (constant)."; x }

def u:thrush(x, y) { "T x y = y x (reverse application)."; call(y, x) }

def u:bluebird(f, g, x) { "B f g x = f (g x) (composition).";
  call(f, call(g, x))
}

def u:cardinal(f, x, y) { "C f x y = f y x (flip).";
  call(f, y, x)
}

def u:vireo(f, x, y) { "V f x y = f x y (pairing/application).";
  call(f, x, y)
}

def u:warbler(f, x) { "W f x = f x x (duplication).";
  call(f, x, x)
}

def u:starling(f, g, x) { "S f g x = f x (g x) (substitution).";
  call(f, x, call(g, x))
}

def u:mockingbird(f) { "M f = f f (self-application)."; call(f, f) }

# Composition-family birds lift B to functions with more inputs or stages.
def u:blackbird(f, g, x, y) { "B1 f g x y = f (g x y).";
  call(f, call(g, x, y))
}

def u:bunting(f, g, x, y, z) { "B2 f g x y z = f (g x y z).";
  call(f, call(g, x, y, z))
}

def u:becard(f, g, h, x) { "B3 f g h x = f (g (h x)).";
  call(f, call(g, call(h, x)))
}

# Birds that route one input through one or more functions.
def u:dove(f, x, g, y) { "D f x g y = f x (g y).";
  call(f, x, call(g, y))
}

def u:eagle(f, x, g, y, z) { "E f x g y z = f x (g y z).";
  call(f, x, call(g, y, z))
}

def u:queer(f, g, x) { "Q f g x = g (f x).";
  call(g, call(f, x))
}

def u:psi(f, g, x, y) { "Psi f g x y = f (g x) (g y).";
  call(f, call(g, x), call(g, y))
}

def u:phoenix(f, g, h, x) { "Phi f g h x = f (g x) (h x).";
  call(f, call(g, x), call(h, x))
}

# Small ordinary functions used to make the higher-order behavior visible.
def u:increment(x) { x + 1 }
def u:double(x) { x * 2 }
def u:add(x, y) { x + y }
def u:subtract(x, y) { x - y }
def u:square(x) { x * x }
def u:sum3(x, y, z) { x + y + z }
# A named packaged outer stage used to compare equivalent bird wirings without
# relying on closures or partial application.
def u:add_square_left(x, y) { u:square(x) + y }
def u:callable_kind(x) { if equal(x, :u:callable_kind) { 1 } else { 0 } }
