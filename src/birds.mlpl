# Bird-named combinators in the applicative style supported by sw-MLPL today.
#
# Each definition is named and contains no free variables. Function values are
# explicit :u: references; call invokes them. Under-application produces a
# callable partial value, so every multi-argument bird supports staged use.

def u:idiot(x) { "I x = x (Identity)."; x }

def u:kestrel(x, y) { "K x y = x (constant)."; x }

def u:thrush(x, y) { "T x y = y x (reverse application)."; call(y, x) }

def u:bluebird(f, g, x) { "B f g x = f (g x) (composition).";
  call(f, call(g, x))
}

def u:cardinal(f, x, y) { "C f x y = f y x (flip).";
  call(f, y, x)
}

def u:vireo(x, y, f) { "V x y f = f x y (pairing/application).";
  call(f, x, y)
}

def u:warbler(f, x) { "W f x = f x x (duplication).";
  call(f, x, x)
}

def u:starling(f, g, x) { "S f g x = f x (g x) (substitution).";
  call(f, x, call(g, x))
}

def u:mockingbird(f) { "M f = f f (self-application)."; call(f, f) }

# Composition-family birds lift B to functions with more inputs or stages.
def u:blackbird(f, g, x, y) { "B1 f g x y = f (g x y).";
  call(f, call(g, x, y))
}

def u:bunting(f, g, x, y, z) { "B2 f g x y z = f (g x y z).";
  call(f, call(g, x, y, z))
}

def u:becard(f, g, h, x) { "B3 f g h x = f (g (h x)).";
  call(f, call(g, call(h, x)))
}

# Birds that route one input through one or more functions.
def u:dove(f, x, g, y) { "D f x g y = f x (g y).";
  call(f, x, call(g, y))
}

def u:eagle(f, x, g, y, z) { "E f x g y z = f x (g y z).";
  call(f, x, call(g, y, z))
}

def u:queer(f, g, x) { "Q f g x = g (f x).";
  call(g, call(f, x))
}

def u:psi(f, g, x, y) { "Psi f g x y = f (g x) (g y).";
  call(f, call(g, x), call(g, y))
}

def u:phoenix(f, g, h, x) { "Phi f g h x = f (g x) (h x).";
  call(f, call(g, x), call(h, x))
}

# Self-application and nested-application birds that do not require partials
# when invoked at their complete arity.
def u:lark(f, x) { "L f x = f (x x).";
  call(f, call(x, x))
}

def u:owl(f, g) { "O f g = g (f g).";
  call(g, call(f, g))
}

# Canonical permutation and cancellation birds. Unlike sw-MLPL's function-
# first HOF helpers, their argument order follows the standard bird equations.
def u:kite(x, y) { "KI x y = y (second projection)."; y }

def u:robin(x, f, y) { "R x f y = f y x.";
  call(f, y, x)
}

def u:finch(x, y, f) { "F x y f = f y x.";
  call(f, y, x)
}

def u:goldfinch(f, g, x, y) { "G f g x y = f y (g x).";
  call(f, y, call(g, x))
}

def u:hummingbird(f, x, y) { "H f x y = f x y x.";
  call(f, x, y, x)
}

def u:jay(f, x, y, z) { "J f x y z = f x (f z y).";
  call(f, x, call(f, z, y))
}

# Higher-arity routing birds. These are valuable runtime stress cases because
# they nest unary, binary, and ternary named calls while remaining exact-arity.
def u:violet_starling(f, g, x) { "Sigma f g x = f (g x) x.";
  call(f, call(g, x), x)
}

def u:zebra_dove(f, g, x, y) { "Delta f g x y = f (g x) y.";
  call(f, call(g, x), y)
}

def u:dickcissel(f, x, y, g, z) { "D1 f x y g z = f x y (g z).";
  call(f, x, y, call(g, z))
}

def u:dovekie(f, g, x, h, y) { "D2 f g x h y = f (g x) (h y).";
  call(f, call(g, x), call(h, y))
}

def u:eastern_nicator(f, x, g, y) { "N f x g y = f x (g x y).";
  call(f, x, call(g, x, y))
}

def u:western_nicator(f, g, x, y) { "Nu f g x y = f (g x y) y.";
  call(f, call(g, x, y), y)
}

def u:bald_eagle(f, g, x, y, h, z, w) { "E-hat f g x y h z w = f (g x y) (h z w).";
  call(f, call(g, x, y), call(h, z, w))
}

# Small ordinary functions used to make the higher-order behavior visible.
def u:increment(x) { x + 1 }
def u:double(x) { x * 2 }
def u:add(x, y) { x + y }
def u:subtract(x, y) { x - y }
def u:square(x) { x * x }
def u:sum3(x, y, z) { x + y + z }
# A named packaged outer stage used to compare equivalent bird wirings without
# relying on closures or partial application.
def u:add_square_left(x, y) { u:square(x) + y }
def u:callable_kind(x) { if equal(x, :u:callable_kind) { 1 } else { 0 } }

# Fixed, named stages for the practical ML-pipeline lesson. They deliberately
# use pervasive arithmetic, so one definition handles a whole feature vector.
def u:center_features(x) { x - mean(x) }
def u:affine_features(x) { x * 2 + 1 }
def u:relu_features(x) { x * gt(x, 0) }
def u:classify_features(x) { gt(x, 1) }

def u:feature_pipeline(x) { "Center, transform, activate, and classify a feature vector.";
  u:bluebird(
    :u:classify_features,
    :u:three_stage_features,
    x
  )
}

def u:three_stage_features(x) {
  u:becard(:u:relu_features, :u:affine_features, :u:center_features, x)
}
