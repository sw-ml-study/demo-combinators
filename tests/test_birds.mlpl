include "src/birds.mlpl";

@test {name: "foundational bird equations", tags: ["birds", "unit", "current"]}
def u:test_foundations() { "Verify identity, constant, reverse application, pairing, and flip.";
  u:assert_eq(u:idiot([1, 2, 3]), [1, 2, 3], "I preserves its argument")?;
  u:assert_eq(u:kestrel(5, 99), 5, "K retains its first argument")?;
  u:assert_eq(u:thrush(20, :u:increment), 21, "T reverses application")?;
  u:assert_eq(u:vireo(:u:add, 8, 13), 21, "V applies a binary function")?;
  u:assert_eq(u:cardinal(:u:subtract, 3, 10), 7, "C flips arguments")
}

@test {name: "composition is rank-polymorphic", tags: ["birds", "arrays", "composition"]}
def u:test_bluebird() { "Verify B composes the same functions over scalar and array data.";
  u:assert_eq(u:bluebird(:u:increment, :u:double, 10), 21, "B scalar composition")?;
  u:assert_eq(u:bluebird(:u:increment, :u:double, [1, 2, 3]), [3, 5, 7], "B vector composition")?;
  u:assert_eq(atop(:u:increment, :u:double, [1, 2, 3]), [3, 5, 7], "atop agrees with B")
}

@test {name: "duplication substitution and self application", tags: ["birds", "higher-order", "current"]}
def u:test_higher_order() { "Verify W, S, and M using explicit named function references.";
  u:assert_eq(u:warbler(:u:add, 7), 14, "W duplicates its argument")?;
  u:assert_eq(u:starling(:u:add, :u:square, 4), 20, "S shares its argument")?;
  u:assert_eq(u:mockingbird(:u:callable_kind), 1, "M passes a function its own reference")
}

@test {name: "extended composition family", tags: ["birds", "composition", "current"]}
def u:test_composition_family() { "Verify Blackbird, Bunting, Becard, and Queer composition shapes.";
  u:assert_eq(u:blackbird(:u:square, :u:add, 2, 3), 25, "B1 composes over a binary function")?;
  u:assert_eq(u:bunting(:u:double, :u:sum3, 2, 3, 4), 18, "B2 composes over a ternary function")?;
  u:assert_eq(u:becard(:u:increment, :u:double, :u:square, 3), 19, "B3 composes three unary stages")?;
  u:assert_eq(u:queer(:u:double, :u:increment, 10), 21, "Q reverses B's function order")
}

@test {name: "fork and routing family", tags: ["birds", "routing", "arrays", "current"]}
def u:test_routing_family() { "Verify Dove, Eagle, Psi, and Phoenix route values without closures.";
  u:assert_eq(u:dove(:u:add, 10, :u:square, 3), 19, "D routes one transformed input")?;
  u:assert_eq(u:eagle(:u:add, 10, :u:add, 3, 4), 17, "E routes a binary inner result")?;
  u:assert_eq(u:psi(:u:add, :u:square, 3, 4), 25, "Psi maps one function over two inputs")?;
  u:assert_eq(u:phoenix(:u:add, :u:square, :u:double, 3), 15, "Phi forks one input")?;
  u:assert_eq(u:phoenix(:u:add, :u:square, :u:double, [1, 2, 3]), [3, 8, 15], "Phi forks arrays pervasively")
}

@test {name: "bird equations agree with derived forms", tags: ["birds", "derivation", "current"]}
def u:test_derived_equations() { "Verify selected birds are equivalent wiring descriptions.";
  u:assert_eq(
    u:queer(:u:double, :u:increment, [1, 2, 3]),
    u:bluebird(:u:increment, :u:double, [1, 2, 3]),
    "Q f g agrees with B g f"
  )?;
  u:assert_eq(
    u:phoenix(:u:add, :u:square, :u:double, [1, 2, 3]),
    u:starling(:u:add_square_left, :u:double, [1, 2, 3]),
    "Phi fork agrees with S when its left branch is packaged"
  )
}

@test {name: "nested self application birds", tags: ["birds", "self-application", "current"]}
def u:test_nested_self_application() { "Verify Lark and Owl at full arity on current sw-MLPL.";
  u:assert_eq(u:lark(:u:increment, :u:callable_kind), 2, "L applies x to itself before f")?;
  u:assert_eq(u:owl(:u:callable_kind, :u:increment), 1, "O feeds f(g) into g")
}

@test {name: "bird-composed feature pipeline", tags: ["birds", "arrays", "ml", "current"]}
def u:test_feature_pipeline() { "Verify a four-stage array transformation assembled with B and B3.";
  u:assert_eq(u:center_features([1, 2, 3]), [0 - 1, 0, 1], "centering stage")?;
  u:assert_eq(u:feature_pipeline([1, 2, 3]), [0, 0, 1], "composed feature classification")
}

u:run_registered_tests()
